# ==============================================================
# SD INPRES LONRONG - TEMPLATE VARIABEL LINGKUNGAN (ENV EXAMPLE)
# PANDUAN KEAMANAN:
# 1. Salin file ini menjadi '.env' untuk penggunaan lokal:
#    cp .env.example .env
# 2. JANGAN PERNAH commit file '.env' berisi kunci asli ke GitHub!
# ==============================================================

# Mode Aplikasi
VITE_APP_ENV=production
VITE_APP_TITLE="SD Inpres Lonrong - Sistem Manajemen Sekolah"

# Integrasi Cloud Database (Supabase PostgreSQL)
# Diperoleh dari Dashboard Supabase -> Project Settings -> API
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Integrasi Google Drive E-Filing (Opsional untuk Sync Cloud Eksternal)
VITE_GOOGLE_DRIVE_FOLDER_ID=""
VITE_GOOGLE_CLIENT_ID=""
VITE_GOOGLE_API_KEY=""

# Backup Sync Endpoint (Bila dihubungkan ke server cloud terpusat)
VITE_SYNC_SERVER_URL=""
VITE_SYNC_API_TOKEN=""
